# ULX3S (LFE5U-25F/45F/85F, CABGA381): 25 MHz oscillator, button 0, LEDs 0 and 1
LOCATE COMP "clk" SITE "G2";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;
LOCATE COMP "rst_n" SITE "D6";
IOBUF PORT "rst_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "led_r" SITE "B2";
LOCATE COMP "led_g" SITE "C2";
IOBUF PORT "led_r" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led_g" IO_TYPE=LVCMOS33 DRIVE=4;
