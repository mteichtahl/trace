# The trace tools image (linux/arm64): the programs too large for the agent image, run as each project's tools
# function (AWS Lambda, src/infra/project.ts). AgentCore Runtime refuses an image over 2 GB, so KiCad and its
# libraries, Blender, the FPGA and verification toolchain, CalculiX and ffmpeg live here; Lambda takes images up to
# 10 GB. One invocation is one job (src/gpu/lambda.ts runs src/gpu/runner.ts on the job's spec in S3): the agent's
# runJob sends the kinds in src/gpu/jobs.ts FUNCTION_KINDS here, and KiCad's command line through
# src/tools/kicad/remote.ts and src/gpu/kicad-job.ts.
#
# Lambda runs the image as an unprivileged user with a read-only filesystem but /tmp, so every program's home,
# configuration and cache are under /tmp (HOME, XDG_*), and nothing in the image needs to be owned by that user.
#
# Three stages, as agent/Dockerfile: tools (the system packages), build (left behind), final.
# Docker Hub's official ubuntu image as mirrored on Amazon ECR Public: CodeBuild's shared addresses hit Docker Hub's
# anonymous pull limit (429 toomanyrequests); ECR Public has none for AWS builds
FROM --platform=linux/arm64 public.ecr.aws/docker/library/ubuntu:24.04 AS tools

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC

# Base tools. build-essential and python3-dev: Verilator compiles its models with g++ at run time, and pip builds
# cocotb from source below (it publishes no arm64 Linux wheel; its C++ extensions need Python.h). ffmpeg encodes
# render frames into a video (src/tools/render/tools.ts), iverilog is cocotb's Icarus simulator.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg git xz-utils \
      build-essential python3 python3-dev python3-venv python3-pip ffmpeg iverilog \
 && rm -rf /var/lib/apt/lists/*

# Node 22 (NodeSource: the job runner) and KiCad 10 (ppa:kicad/kicad-10.0-releases, which builds arm64 for noble), as
# in agent/Dockerfile before KiCad moved here.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
 && curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xFDA854F61C4D0D9572BB95E5245D5502FAD7A805" | gpg --dearmor -o /etc/apt/keyrings/kicad.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/kicad.gpg] https://ppa.launchpadcontent.net/kicad/kicad-10.0-releases/ubuntu noble main" > /etc/apt/sources.list.d/kicad-10.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && (apt-get install -y --no-install-recommends kicad kicad-symbols kicad-footprints \
     || (echo "KiCad 10 from the PPA is not installable here: falling back to Ubuntu's kicad" \
         && rm /etc/apt/sources.list.d/kicad-10.list && apt-get update \
         && apt-get install -y --no-install-recommends kicad kicad-symbols kicad-footprints)) \
 && kicad-cli version && node --version \
 && rm -rf /var/lib/apt/lists/*

# Blender (src/tools/render, for installations without the GPU queue: Cycles on the CPU). python3-numpy: Ubuntu's
# Blender uses the system Python, and its glTF importer needs numpy.
RUN apt-get update && apt-get install -y --no-install-recommends blender python3-numpy && blender --version && rm -rf /var/lib/apt/lists/*

# Verification and FPGA implementation (src/tools/verify, src/tools/fpga): Verilator, Yosys, nextpnr for ice40, ECP5
# and Gowin, the IceStorm and Trellis packers, and z3 for formal (yosys-smtbmc). SymbiYosys from its repository at the
# tag matching Ubuntu's Yosys; without that tag, verify.formal runs yosys + yosys-smtbmc directly.
# src/tools/verify/job.ts TOOLS_IMAGE_PROGRAMS lists what this layer and the venv below provide (not sby, which may be
# missing: formal on the function uses the smtbmc engine).
RUN apt-get update \
 && apt-get install -y --no-install-recommends verilator yosys nextpnr-ice40 nextpnr-ecp5 nextpnr-gowin fpga-icestorm fpga-trellis z3 \
 && rm -rf /var/lib/apt/lists/* \
 && YV="$(yosys -V | sed -E 's/^Yosys ([0-9]+\.[0-9]+).*/\1/')" \
 && (git clone --depth 1 --branch "v${YV}" https://github.com/YosysHQ/sby.git /tmp/sby && make -C /tmp/sby install PREFIX=/usr/local \
     || echo "note: SymbiYosys v${YV} not installed; verify.formal uses yosys-smtbmc directly") \
 && rm -rf /tmp/sby \
 && verilator --version && yosys -V && nextpnr-ice40 --version

# Thermal (src/tools/thermal): CalculiX ccx 2.21 for the 3D finite-element path (thermal.board solver=calculix).
RUN apt-get update && apt-get install -y --no-install-recommends calculix-ccx=2.21-1 && rm -rf /var/lib/apt/lists/* \
 && command -v ccx

# ------------------------------------------------------------------ build: the job runner and the Python venv
FROM tools AS build
WORKDIR /app
COPY package.json agent/package-lock.json agent/npmrc ./
RUN mv npmrc .npmrc
RUN npm ci --ignore-scripts
COPY . .
# The runner needs a handful of packages (the S3, Batch, SNS and SQS clients, OpenTelemetry's API, zod): the largest
# of the others, the Agent SDK's native binaries and the CDK the installer deploys with, are left out;
# scripts/check-imports.mjs fails the build if the function's code imports one of them.
RUN npm run build:image \
 && npm prune --omit=dev \
 && npm rebuild \
 && rm -rf node_modules/@anthropic-ai node_modules/aws-cdk-lib node_modules/aws-cdk node_modules/@aws-cdk node_modules/constructs \
 && node scripts/check-imports.mjs --without @anthropic-ai/claude-agent-sdk,@anthropic-ai/sdk,aws-cdk-lib,aws-cdk,constructs dist/gpu/lambda.js dist/gpu/kicad-job.js \
 && python3 -m venv /opt/trace-venv \
 && /opt/trace-venv/bin/pip install --no-cache-dir 'cocotb==2.1.0' 'apycula==0.10.0'

# ------------------------------------------------------------------ final: what the tools function runs
FROM tools
COPY --from=build /app /app
COPY --from=build /opt/trace-venv /opt/trace-venv
ENV PATH=/opt/trace-venv/bin:$PATH \
    TRACE_PYTHON=/opt/trace-venv/bin/python \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_CACHE_HOME=/tmp/.cache \
    XDG_DATA_HOME=/tmp/.local/share \
    NODE_ENV=production
WORKDIR /tmp
RUN test -f /app/dist/gpu/lambda.js && test -f /app/dist/gpu/kicad-job.js && test -d /app/python/blender && command -v kicad-cli blender ffmpeg yosys verilator ccx cocotb-config gowin_pack
CMD ["node", "/app/dist/gpu/lambda.js"]
