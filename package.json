{
  "name": "@mteichtahl/trace",
  "version": "0.1.0",
  "description": "trace: an autonomous repository harness and an electronics toolkit (KiCad, simulation, datasheets, parts, hardware-in-the-loop, firmware) for Claude Code",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:mteichtahl/trace",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "tracectl": "dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "harness",
    "templates",
    "python",
    "scripts",
    "agent",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node scripts/stage-image.mjs && tsc -p tsconfig.json && node scripts/bundle-harness.mjs && node scripts/bundle-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "deploy:release": "node scripts/deploy-release.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.3",
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-batch": "^3.1156.0",
    "@aws-sdk/client-bedrock": "^3.1156.0",
    "@aws-sdk/client-bedrock-agent": "^3.1156.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1156.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1156.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1156.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-cloudwatch": "^3.1156.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1156.0",
    "@aws-sdk/client-codebuild": "^3.1156.0",
    "@aws-sdk/client-codeconnections": "^3.1156.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1156.0",
    "@aws-sdk/client-cost-explorer": "^3.1156.0",
    "@aws-sdk/client-iam": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-polly": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sns": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@aws-sdk/client-xray": "3.1156.0",
    "@aws-sdk/credential-providers": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "0.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "1.10.0",
    "@serialport/bindings-cpp": "^13.0.0",
    "@serialport/bindings-interface": "^1.2.2",
    "@serialport/stream": "^13.0.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "@smithy/signature-v4": "^5.7.4",
    "@smithy/types": "^4.19.0",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "libsodium-wrappers": "^0.8.4",
    "pdfjs-dist": "6.4.299",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@serialport/binding-mock": "^10.2.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
